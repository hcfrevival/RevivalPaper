From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: j-rockwell <john@llewkcor.com>
Date: Thu, 15 Oct 2026 20:02:14 -0700
Subject: [PATCH] Damage windows

Melee, projectile, mob and other damage each get their own damage window
when legacy-combat.damage-windows is on, so a sword combo no longer
swallows fire, poison, arrows or mob hits. hurtServer swaps the channel's
window into invulnerableTime/lastHurt around the vanilla body. The logic
lives in gg.hcfrevival.revival.combat.DamageWindows; this patch only calls
into it.

diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index afa30cd878eaf3fc0e5187f92f9b5d254ef6fc0f..a7ea0307b8a899e3c7033ba9957f43bc404d6972 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -261,6 +261,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
     protected boolean dead;
     public int noActionTime;
     public float lastHurt;
+    public gg.hcfrevival.revival.combat.@org.jspecify.annotations.Nullable DamageWindows revivalDamageWindows; // Revival - Damage windows
     protected boolean jumping;
     public float xxa; public float getStrafeMot() { return xxa; } public void setStrafeMot(float strafe) { xxa = strafe; } // Purpur - OBFHELPER
     public float yya; public float getVerticalMot() { return yya; } public void setVerticalMot(float vertical) { yya = vertical; } // Purpur - OBFHELPER
@@ -1490,12 +1491,24 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
 
     // Gale start - Pufferfish - reduce in wall checks
     private boolean couldPossiblyBeHurt(float amount) {
+        if (gg.hcfrevival.revival.combat.DamageWindows.enabled(this)) return true; // Revival - Damage windows: the fields hold only the melee window
         return !((float) this.invulnerableTime > (float) this.invulnerableDuration / 2.0F) || !(amount <= this.lastHurt);
     }
     // Gale end - Pufferfish - reduce in wall checks
 
     @Override
     public boolean hurtServer(final ServerLevel level, final DamageSource source, float damage) {
+        // Revival start - Damage windows
+        final int revivalWindow = gg.hcfrevival.revival.combat.DamageWindows.enter(this, source);
+        try {
+            return this.revivalHurtServer(level, source, damage);
+        } finally {
+            gg.hcfrevival.revival.combat.DamageWindows.exit(this, revivalWindow);
+        }
+    }
+
+    private boolean revivalHurtServer(final ServerLevel level, final DamageSource source, float damage) {
+        // Revival end - Damage windows
         if (this.isInvulnerableTo(level, source)) {
             return false;
         }
