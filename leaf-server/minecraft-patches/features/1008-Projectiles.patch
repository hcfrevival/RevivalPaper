From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: j-rockwell <john@llewkcor.com>
Date: Mon, 12 Oct 2026 10:28:55 -0700
Subject: [PATCH] Projectiles

Legacy rod, bow, snowball and egg hits: 0-damage hits land on players,
knockback comes from the shooter through the knockback engine with Punch
folded in, and rods hit on impact, cast and fall like 1.7 and reel with
the 1.7 pull. The logic lives in gg.hcfrevival.revival.combat; this patch
only calls into it.

diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index af1d569368ee3fa33ec3cb05ef1f36fb5e4ff768..8ebfeae9c2d103cddba4b17353b381f52dbca0a7 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -1564,7 +1564,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             if (!this.actuallyHurt(level, source, (float)event.getFinalDamage(), event)) { // Paper - fix invulnerability reduction in EntityDamageEvent - no longer subtract lastHurt, that is part of the damage event calc now
                 return false;
             }
-            if (this instanceof ServerPlayer && event.getDamage() == 0 && originalDamage == 0) return false; // Paper - revert to vanilla damage - players are not affected by damage that is 0 - skip damage if the vanilla damage is 0 and was not modified by plugins in the event.
+            if (this instanceof ServerPlayer && event.getDamage() == 0 && originalDamage == 0 && !gg.hcfrevival.revival.combat.LegacyProjectiles.zeroDamageHit(this, source)) return false; // Paper - revert to vanilla damage - players are not affected by damage that is 0 - skip damage if the vanilla damage is 0 and was not modified by plugins in the event. // Revival - Projectiles
             // CraftBukkit end
             this.lastHurt = gg.hcfrevival.revival.combat.LegacyDefence.lastHurt(source, damage, event); // Revival - Damage immunity
             tookFullDamage = false;
@@ -1577,7 +1577,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             if (!this.actuallyHurt(level, source, (float)event.getFinalDamage(), event)) {
                 return false;
             }
-            if (this instanceof ServerPlayer && event.getDamage() == 0 && originalDamage == 0) return false; // Paper - revert to vanilla damage - players are not affected by damage that is 0 - skip damage if the vanilla damage is 0 and was not modified by plugins in the event.
+            if (this instanceof ServerPlayer && event.getDamage() == 0 && originalDamage == 0 && !gg.hcfrevival.revival.combat.LegacyProjectiles.zeroDamageHit(this, source)) return false; // Paper - revert to vanilla damage - players are not affected by damage that is 0 - skip damage if the vanilla damage is 0 and was not modified by plugins in the event. // Revival - Projectiles
             this.lastHurt = gg.hcfrevival.revival.combat.LegacyDefence.lastHurt(source, damage, event); // Revival - Damage immunity
             this.damageCooldownTime = this.invulnerableDuration; // CraftBukkit - restore use of maxNoDamageTicks
             // this.actuallyHurt(level, source, damage);
diff --git a/net/minecraft/world/entity/projectile/FishingHook.java b/net/minecraft/world/entity/projectile/FishingHook.java
index b0794a77b44e922bb6c71a28560054656acae922..435760b16e0453782408b1d16315558e291f0aeb 100644
--- a/net/minecraft/world/entity/projectile/FishingHook.java
+++ b/net/minecraft/world/entity/projectile/FishingHook.java
@@ -93,6 +93,7 @@ public class FishingHook extends Projectile {
         // Paper end - Configurable fishing time ranges
     }
 
+    public double revivalGravity = -1.0; // Revival - Projectiles: a legacy rod's gravity, or -1
     public FishingHook(final EntityType<? extends FishingHook> type, final Level level) {
         this(type, level, 0, 0);
     }
@@ -122,6 +123,7 @@ public class FishingHook extends Projectile {
         this.setXRot((float)(Mth.atan2(newMovement.y, newMovement.horizontalDistance()) * 180.0F / (float)Math.PI));
         this.yRotO = this.getYRot();
         this.xRotO = this.getXRot();
+        gg.hcfrevival.revival.combat.LegacyProjectiles.cast(this, player); // Revival - Projectiles
     }
 
     @Override
@@ -298,7 +300,7 @@ public class FishingHook extends Projectile {
     @Override
     protected void onHitEntity(final EntityHitResult hitResult) {
         super.onHitEntity(hitResult);
-        if (!this.level().isClientSide()) {
+        if (!this.level().isClientSide() && gg.hcfrevival.revival.combat.LegacyProjectiles.rodHits(this, hitResult.getEntity())) { // Revival - Projectiles
             this.setHookedEntity(hitResult.getEntity());
         }
     }
@@ -510,10 +512,11 @@ public class FishingHook extends Projectile {
                 }
                 if (this.hookedIn != null) { // Paper - re-check to see if there is a hooked entity
                 // CraftBukkit end
-                this.pullEntity(this.hookedIn);
+                final int legacyReel = gg.hcfrevival.revival.combat.LegacyProjectiles.reel(this, this.hookedIn); // Revival - Projectiles
+                if (legacyReel < 0) this.pullEntity(this.hookedIn); // Revival - Projectiles
                 CriteriaTriggers.FISHING_ROD_HOOKED.trigger((ServerPlayer)owner, rod, this, Collections.emptyList());
-                this.level().broadcastEntityEvent(this, EntityEvent.FISHING_ROD_REEL_IN);
-                dmg = this.hookedIn instanceof ItemEntity ? 3 : 5;
+                if (legacyReel < 0) this.level().broadcastEntityEvent(this, EntityEvent.FISHING_ROD_REEL_IN); // Revival - Projectiles: 1.7 never showed the pull
+                dmg = legacyReel >= 0 ? legacyReel : this.hookedIn instanceof ItemEntity ? 3 : 5; // Revival - Projectiles
                 } // Paper - re-check to see if there is a hooked entity
             } else if (this.nibble > 0) {
                 LootParams params = new LootParams.Builder((ServerLevel)this.level())
@@ -593,7 +596,7 @@ public class FishingHook extends Projectile {
 
     @Override
     protected double getDefaultGravity() {
-        return 0.03F;
+        return this.revivalGravity >= 0.0 ? this.revivalGravity : 0.03F; // Revival - Projectiles
     }
 
     public void pullEntity(final Entity entity) {
diff --git a/net/minecraft/world/entity/projectile/arrow/AbstractArrow.java b/net/minecraft/world/entity/projectile/arrow/AbstractArrow.java
index 319fd20911d6f2eb7e46815b6661da5defd6921e..263c78f4579ccacf45e93722dd341c581923e836 100644
--- a/net/minecraft/world/entity/projectile/arrow/AbstractArrow.java
+++ b/net/minecraft/world/entity/projectile/arrow/AbstractArrow.java
@@ -551,6 +551,7 @@ public abstract class AbstractArrow extends Projectile {
     }
 
     protected void doKnockback(final LivingEntity mob, final DamageSource damageSource) {
+        if (gg.hcfrevival.revival.combat.LegacyProjectiles.punchIncluded(mob, damageSource)) return; // Revival - Projectiles: Punch is already in the knock
         double knockback = this.firedFromWeapon != null && this.level() instanceof ServerLevel serverLevel
             ? EnchantmentHelper.modifyKnockback(serverLevel, this.firedFromWeapon, mob, damageSource, 0.0F)
             : 0.0F;
