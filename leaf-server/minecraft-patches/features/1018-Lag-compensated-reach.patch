                     if (!mainHandItem.has(DataComponents.PIERCING_WEAPON)) {
                         if (target instanceof net.minecraft.world.entity.Mob mob) mob.ticksSinceLastInteraction = 0; // Purpur - Entity lifespan
                         if (target instanceof ItemEntity
