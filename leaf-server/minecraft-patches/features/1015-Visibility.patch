From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shaynelarocque <shaynelarocque@gmail.com>
Date: Wed, 21 Oct 2026 22:15:51 -0400
Subject: [PATCH] Visibility
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

With authoritative.visibility.enabled, a player is not sent to a viewer
under authority that has no line of sight to it through the blocks it was
sent (design §11): the tracker's pairing decision asks the netcode after
the vanish check, so a hidden player is unpaired and re-shown with a fresh
spawn when it comes into view.

diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index 0a0dad530483297ef6313cad73b41e317aff5b3d..9889d32adabfd2d4624cc19a1cdacf1fcd4c4a6e 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -1514,6 +1514,7 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
                 if (visibleToPlayer && !player.getBukkitEntity().canSeeChunkMapUpdatePlayer(this.entity.getBukkitEntity())) { // Paper - only consider hits // SparklyPaper - optimize canSee checks
                     visibleToPlayer = false;
                 }
+                if (visibleToPlayer && !gg.hcfrevival.revival.auth.Authority.visibleTo(this.entity, player)) visibleToPlayer = false; // Revival - Visibility: no line of sight
                 // CraftBukkit end
                 if (visibleToPlayer) {
                     if (this.seenBy.add(player.connection)) {
@@ -1662,6 +1663,7 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
                 if (visibleToPlayer && !player.getBukkitEntity().canSeeChunkMapUpdatePlayer(this.entity.getBukkitEntity())) { // Paper - only consider hits // SparklyPaper - optimize canSee checks
                     visibleToPlayer = false;
                 }
+                if (visibleToPlayer && !gg.hcfrevival.revival.auth.Authority.visibleTo(this.entity, player)) visibleToPlayer = false; // Revival - Visibility: no line of sight
                 // CraftBukkit end
                 if (visibleToPlayer) {
                     if (this.seenBy.add(player.connection)) {
