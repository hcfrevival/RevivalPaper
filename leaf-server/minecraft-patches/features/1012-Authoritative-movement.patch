+    // Revival start - Authoritative movement: the simulated truth takes the accepted-move path a claim takes today
+    // The move being handled is the simulated truth: the movement checks are the simulation's, not Paper's guesses from a
+    // stale reference and the server's delta movement (they set back exact truths: a knocked player falling)
+    private boolean revivalTruth;
+    // The truth path: no second collision pass (the truth is already collided) and only the final position runs the
+    // waypoint updates; every event and side effect of the branch stays, in its order (design §15.5)
+    private boolean revivalResolved;
+
+    public void revivalApplyTruth(final double x, final double y, final double z, final float yRot, final float xRot, final boolean onGround, final boolean horizontalCollision) {
+        this.revivalApplyTruth(x, y, z, yRot, xRot, onGround, horizontalCollision, true);
+    }
+
+    /**
+     * {@code resolved == false} is the branch exactly as a claim takes it (a collision pass, every interim position with
+     * its waypoint updates): the reference the live test TruthPathCheck compares the truth path against.
+     */
+    public void revivalApplyTruth(final double x, final double y, final double z, final float yRot, final float xRot, final boolean onGround, final boolean horizontalCollision,
+                                  final boolean resolved) {
+        if (this.hasClientLoaded() && !this.updateAwaitingTeleport()) {
+            this.revivalTruth = true;
+            this.revivalResolved = resolved;
+            try {
+                this.handlePlayerPositionChange(x, y, z, yRot, xRot, onGround, horizontalCollision);
+            } finally {
+                this.revivalTruth = false;
+                this.revivalResolved = false;
+            }
+        }
+    }
+
+    /**
+     * A server teleport is complete at its pong window (design §15.3): vanilla's bookkeeping for its accept, without
+     * taking the accept's coordinates (the truth already has the destination; the accept is judged as a claim).
+     */
+    public boolean revivalCompleteServerTeleport(final int id) {
+        if (id != this.awaitingTeleport || this.awaitingPositionFromClient == null) {
+            return false; // done already, or a later teleport is still on its way: vanilla waits for that one
+        }
+        this.player.absSnapTo(this.awaitingPositionFromClient.x, this.awaitingPositionFromClient.y, this.awaitingPositionFromClient.z,
+            this.player.getYRot(), this.player.getXRot());
+        this.lastGoodX = this.awaitingPositionFromClient.x;
+        this.lastGoodY = this.awaitingPositionFromClient.y;
+        this.lastGoodZ = this.awaitingPositionFromClient.z;
+        this.player.hasChangedDimension();
+        this.awaitingPositionFromClient = null;
+        return true;
+    }
+
+    /** The newest teleport id vanilla issued (awaited or completed): an accept for a later one was never sent. */
+    public int revivalLastTeleportId() {
+        return this.awaitingTeleport;
+    }
+    // Revival end - Authoritative movement
+
