+    // Revival start - Authoritative movement: the truth path
+    // A truth the simulation already collided: move() takes its delta as the collided movement (no second collision pass)
+    private boolean revivalResolvedMove;
+    // setPosRaw skips the waypoint updates (O(players) each) for a position the truth path leaves again in the same call;
+    // the entity sections still follow every write, so a plugin listener in between sees a consistent entity
+    private boolean revivalQuietWaypoints;
+
+    /**
+     * {@code move(PLAYER, delta)} for a move the simulation already resolved: every side effect of the accepted-move
+     * branch's move (movement records, steps, sounds and vibrations, collision flags, block speed, stuck reset) runs as
+     * for a claim, with {@code delta} as the collided movement. A claim's second pass returns {@code delta} unchanged for
+     * an exact truth; the position it leaves is an interim one (the handler writes the target once at the end).
+     */
+    public final void revivalMoveResolved(final Vec3 delta) {
+        this.revivalResolvedMove = true;
+        try {
+            this.move(MoverType.PLAYER, delta);
+        } finally {
+            this.revivalResolvedMove = false;
+            this.revivalQuietWaypoints = false;
+        }
+    }
+
+    /** {@code absSnapTo} for an interim position of the truth path: everything but the waypoint updates. */
+    public final void revivalQuietSnapTo(final double x, final double y, final double z, final float yRot, final float xRot) {
+        this.revivalQuietWaypoints = true;
+        try {
+            this.absSnapTo(x, y, z, yRot, xRot);
+        } finally {
+            this.revivalQuietWaypoints = false;
+        }
+    }
+    // Revival end - Authoritative movement
+
