From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shaynelarocque <shaynelarocque@gmail.com>
Date: Wed, 21 Oct 2026 19:51:26 -0400
Subject: [PATCH] Authoritative movement

In enforce mode the simulated position is written to the player through
the same accepted-move path a client claim takes today (events, chunk
moves, fall damage, statistics), and the zero-input server travel is
skipped while the simulation owns the player's movement.

The simulation is also the only writer of the player's pose, swimming,
gliding and item-use state: the server's own per-tick recomputation of
them is skipped, and a change the server makes on purpose (a plugin, an
axe disabling a shield, a finished meal) is reported so it reaches the
client in a transaction.

diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index 10f015b7d83e78772484d309f8ed4baeba5ae34f..b65bfa38d8aa05308125e7a5cd1d3184f0394528 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -1578,6 +1578,32 @@ public class ServerGamePacketListenerImpl
         }
     }
 
+    // Revival start - Authoritative movement: the simulated truth takes the accepted-move path a claim takes today
+    public void revivalApplyTruth(final double x, final double y, final double z, final float yRot, final float xRot, final boolean onGround, final boolean horizontalCollision) {
+        if (this.hasClientLoaded() && !this.updateAwaitingTeleport()) {
+            this.handlePlayerPositionChange(x, y, z, yRot, xRot, onGround, horizontalCollision);
+        }
+    }
+
+    /**
+     * A server teleport is complete at its pong window (design §15.3): vanilla's bookkeeping for its accept, without
+     * taking the accept's coordinates (the truth already has the destination; the accept is judged as a claim).
+     */
+    public boolean revivalCompleteServerTeleport(final int id) {
+        if (id != this.awaitingTeleport || this.awaitingPositionFromClient == null) {
+            return false; // done already, or a later teleport is still on its way: vanilla waits for that one
+        }
+        this.player.absSnapTo(this.awaitingPositionFromClient.x, this.awaitingPositionFromClient.y, this.awaitingPositionFromClient.z,
+            this.player.getYRot(), this.player.getXRot());
+        this.lastGoodX = this.awaitingPositionFromClient.x;
+        this.lastGoodY = this.awaitingPositionFromClient.y;
+        this.lastGoodZ = this.awaitingPositionFromClient.z;
+        this.player.hasChangedDimension();
+        this.awaitingPositionFromClient = null;
+        return true;
+    }
+    // Revival end - Authoritative movement
+
     private void handlePlayerPositionChange(
         final double requestedX,
         final double requestedY,
