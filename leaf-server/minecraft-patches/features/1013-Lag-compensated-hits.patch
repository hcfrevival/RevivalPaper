From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shaynelarocque <shaynelarocque@gmail.com>
Date: Wed, 21 Oct 2026 19:51:26 -0400
Subject: [PATCH] Lag-compensated hits

Attack packets join the client-tick window like other gameplay packets
and are judged at their place in it, from what the attacker's client saw,
before the original handler runs.

diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index b65bfa38d8aa05308125e7a5cd1d3184f0394528..8d1b58b9c91ba86d0b2dd1ecad8de746b6d10f31 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -3077,6 +3077,7 @@ public class ServerGamePacketListenerImpl
     @Override
     public void handleAttack(final ServerboundAttackPacket packet) {
         PacketUtils.ensureRunningOnSameThread(packet, this, this.player.level());
+        if (this.player.revivalAuth.intercept(packet)) return; // Revival - Lag-compensated hits
         if (this.player.isImmobile()) return; // Paper
         if (this.hasClientLoaded() && !this.player.isSpectator()) {
             ServerLevel level = this.player.level();
